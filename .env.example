# RapidAPI — Arquiler API /calculate
# Se usa para calcular montos estimados de actualización en Dashboard, Cobranzas, Calendario y Portal.
RAPIDAPI_ARQUILER_KEY=

# Google (Calendar + exportación de rendiciones a Sheets). Misma service account.
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# Opcional: spreadsheet de rendiciones (por defecto usa el ID del proyecto).
# GOOGLE_RENDICION_SPREADSHEET_ID=
